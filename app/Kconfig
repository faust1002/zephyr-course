menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice
    prompt "LED blinking speed"
    default BLINK_SPEED_1000MS

config BLINK_SPEED_250MS
    bool "super fast (250ms)"

config BLINK_SPEED_500MS
    bool "fast (500ms)"

config BLINK_SPEED_1000MS
    bool "normal (1s)"

config BLINK_SPEED_2000MS
    bool "slow (2s)"


endchoice

config BLINK_SLEEP_TIME_MS
    int
    default 250 if BLINK_SPEED_250MS
    default 500 if BLINK_SPEED_500MS
    default 1000 if BLINK_SPEED_1000MS
    default 2000 if BLINK_SPEED_2000MS
    help
        "Time between LED toggles in milliseconds"

menuconfig LED_ADVANCED
    bool "Advanced LED Subsystem"
    default n

if LED_ADVANCED

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100
    help
        "LED brightness"

config LED_FADE_DURATION_MS
    int "Fade duration (ms)"
    range 0 5000
    default 500
    help
        "LED fade duration"

menu "Expert settings"
    visible if LED_ADVANCED # This "visible if" clause make very little sense since this menu is already under "if LED_ADVANCED"

config LED_DEBUG
    bool "Enable LED debugging"
    default n
    help
        "Enable LED debugging"

config LED_CUSTOM_PATTERN
    bool "Custom blink pattern"
    default n
    help
        "Enable custom blink pattern"

endmenu

endif # LED_ADVANCED

endif # LED_SUBSYSTEM

config APP_HEARTBEAT_PERIOD_MS
    int "Heartbeat period in ms"
    default 500
    range 100 2000
    help
        "App heartbeat period in ms"

source "Kconfig.zephyr"
